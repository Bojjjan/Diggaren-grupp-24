USE diggaren_tech;

CREATE TABLE diggaren_tech.Tracks (
                        TrackID INT AUTO_INCREMENT PRIMARY KEY,
                        Title VARCHAR(250) CHARACTER SET utf8mb4 NOT NULL,
                        Artist VARCHAR(250) CHARACTER SET utf8mb4 NOT NULL,
                        Genre VARCHAR(100) CHARACTER SET utf8mb4,
                        Duration INT,
                        CONSTRAINT CHK_Duration_Positive CHECK (Duration > 0)
);


CREATE TABLE diggaren_tech.Channels (
                          ChannelID INT AUTO_INCREMENT PRIMARY KEY,
                          Name VARCHAR(250) CHARACTER SET utf8mb4 NOT NULL
);


CREATE TABLE diggaren_tech.PlayHistory (
                             PlayID INT AUTO_INCREMENT PRIMARY KEY,
                             SpotifyID INT NOT NULL,
                             ChannelID INT NOT NULL,
                             Timestamp DATETIME NOT NULL,
                             CONSTRAINT FK_PlayHistory_ChannelID FOREIGN KEY (ChannelID) REFERENCES Channels(ChannelID),
                             CONSTRAINT IX_PH_Timestamp UNIQUE (Timestamp)
);
